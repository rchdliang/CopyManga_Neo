set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT DEFINED ENV{LLVM_MINGW_ROOT})
  message(FATAL_ERROR "Set LLVM_MINGW_ROOT to a verified llvm-mingw toolchain directory")
endif()
file(TO_CMAKE_PATH "$ENV{LLVM_MINGW_ROOT}" LLVM_MINGW_ROOT)
set(LLVM_MINGW_EXE_SUFFIX "")
if(CMAKE_HOST_WIN32)
  set(LLVM_MINGW_EXE_SUFFIX ".exe")
endif()
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang${LLVM_MINGW_EXE_SUFFIX}")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++${LLVM_MINGW_EXE_SUFFIX}")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres${LLVM_MINGW_EXE_SUFFIX}")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
